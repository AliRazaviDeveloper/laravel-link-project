# ---------------------------------------------------------------------------
# Test environment
#
# This file — not phpunit.xml — is where test infrastructure is configured.
#
# The reason is precedence: the containers receive .env as real environment
# variables, and in the CLI SAPI those land in $_SERVER, which Laravel's env
# reader consults before anything PHPUnit sets. An <env> entry in phpunit.xml is
# therefore silently ignored for any key that also appears in .env — even with
# force="true" — and the suite would run against the development databases.
#
# The `test` service in compose.yaml loads this file after .env, so these values
# win as genuine environment variables. Committed on purpose: it holds no secrets
# and every contributor needs the same test wiring.
# ---------------------------------------------------------------------------

APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost

# Separate databases, so running the suite cannot destroy data you were just
# looking at through the API.
DB_DATABASE=shortwave_testing
MONGO_DATABASE=shortwave_testing

# Redis database 15 is reserved for tests and flushed between them.
REDIS_DB=15
REDIS_CACHE_DB=15

CACHE_STORE=redis
# Jobs run inline: the click pipeline is asserted end to end, and a queued job
# waiting on a worker would make every analytics test a race.
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
LOG_CHANNEL=null

SHORTWAVE_SHORT_DOMAIN=https://swv.test
SHORTWAVE_FINGERPRINT_SECRET=testing-fingerprint-secret

# Lowest legal bcrypt cost: the suite creates many accounts and hashing would
# otherwise dominate its runtime.
BCRYPT_ROUNDS=4
