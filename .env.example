# ---------------------------------------------------------------------------
# Shortwave
#
# Copy to .env (`make install` does it for you) and adjust. Defaults are wired
# to the service names in compose.yaml, so a fresh checkout boots unchanged.
# ---------------------------------------------------------------------------

APP_NAME=Shortwave
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Origin used to build short links. Point this at your short domain in production;
# it is deliberately separate from APP_URL, which is the API's own address.
SHORTWAVE_SHORT_DOMAIN=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Postgres: accounts, links, tokens -------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=shortwave
DB_USERNAME=shortwave
DB_PASSWORD=shortwave

# --- MongoDB: the click log ------------------------------------------------
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=shortwave_analytics
MONGO_USERNAME=shortwave
MONGO_PASSWORD=shortwave
MONGO_AUTH_SOURCE=admin

# --- Redis: cache, queue, click counters -----------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# --- Behaviour -------------------------------------------------------------
# Generated slug length. Raising it is always safe; lowering it raises the
# collision rate against slugs that already exist.
SHORTWAVE_SLUG_LENGTH=7

# How long a resolved slug is cached, and how long a nonexistent one is
# remembered as absent.
SHORTWAVE_RESOLUTION_TTL=3600
SHORTWAVE_ABSENT_TTL=30

# Clicks buffered before a batch is handed to the queue.
SHORTWAVE_FLUSH_BATCH=100

# Raw click retention. Also drives the MongoDB TTL index.
SHORTWAVE_RETENTION_DAYS=400

# Salt for the daily visitor fingerprint. MUST be set to a random value in
# production: without it, unique-visitor hashes are predictable. Rotating it
# resets unique counts from that day onward.
SHORTWAVE_FINGERPRINT_SECRET=

# Leave unset for non-expiring API tokens; set to a number of minutes to force
# rotation.
SANCTUM_EXPIRATION=

# --- Host-side compose settings --------------------------------------------
# Published ports are offset from the defaults so the stack does not collide with
# a Postgres, Mongo or Redis already running on the host.
SHORTWAVE_HTTP_PORT=8080
SHORTWAVE_PG_PORT=55432
SHORTWAVE_MONGO_PORT=57017
SHORTWAVE_REDIS_PORT=56379

# `development` mounts the source and ships xdebug; `production` bakes the code in.
SHORTWAVE_BUILD_TARGET=development

# Retryable writes need a replica set; the development container is standalone.
MONGO_RETRY_WRITES=false
